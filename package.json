{
  "name": "chatserver",
  "version": "1.0.0",
  "description": "A bridge between messager apps and LLM models built with TypeScript",
  "main": "dist/index.js",
  "bin": {
    "chatserver": "dist/index.js",
    "chatserver-models": "dist/models/chatserver-models.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "model:add": "node --enable-source-maps dist/models/chatserver-models.js add",
    "model:test": "node --enable-source-maps dist/models/chatserver-models.js test",
    "model:list": "node --enable-source-maps dist/models/chatserver-models.js list",
    "model:update": "node --enable-source-maps dist/models/chatserver-models.js update",
    "model:remove": "node --enable-source-maps dist/models/chatserver-models.js remove",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "chat",
    "llm",
    "typescript",
    "bridge"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.11.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^65.3.11",
    "globals": "^17.13.0",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.71.2",
    "webpack": "^5.112.0",
    "webpack-cli": "^7.2.3"
  }
}
